## Sources

source=~/.config/mango/noctalia.conf

## Output
# AOC Q27B35E
monitorrule=serial:2S6R6HA008726,x:0,y:0,scale:1.0,rr:0

# ASUS VP278
monitorrule=serial:GBLMTF073880,x:2560,y:0,scale:1.0,rr:0

## Input

# Keyboard Settings
numlockon=1
xkb_rules_layout=us
xkb_rules_variant=altgr-intl

# Tablet
devicerule=type:tablet,monitor:serial:2S6R6HA008726
devicerule=type:pad,monitor:serial:2S6R6HA008726

## Startup
exec-once=lxqt-policykit-agent
exec-once=awww-daemon
exec-once=input-remapper-control --command autoload
exec-once=swayidle -w
exec-once=noctalia
exec-once=wl-paste --type text --watch cliphist store
exec-once=wl-paste --type image --watch cliphist store
exec-once=discord --start-minimized --password-store=basic

## Style
# Appearance
borderpx=2
gappoh=5
gappov=5
gappih=3
gappiv=3
# Window effect
blur=0
blur_layer=0
blur_optimized=1
blur_params_num_passes = 2
blur_params_radius = 5
blur_params_noise = 0.02
blur_params_brightness = 0.9
blur_params_contrast = 0.9
blur_params_saturation = 1.2

shadows = 0
layer_shadows = 0
shadow_only_floating = 1
shadows_size = 10
shadows_blur = 15
shadows_position_x = 0
shadows_position_y = 0
shadowscolor= 0x000000ff

border_radius=6
no_radius_when_single=0
focused_opacity=0.98
unfocused_opacity=0.95

# Animation Configuration(support type:zoom,slide)
# tag_animation_direction: 1-horizontal,0-vertical
animations=1
layer_animations=1
animation_type_open=slide
animation_type_close=slide
animation_fade_in=1
animation_fade_out=1
tag_animation_direction=1
zoom_initial_ratio=0.4
zoom_end_ratio=0.8
fadein_begin_opacity=0.5
fadeout_begin_opacity=0.8
animation_duration_move=500
animation_duration_open=400
animation_duration_tag=350
animation_duration_close=800
animation_duration_focus=0
animation_curve_open=0.46,1.0,0.29,1
animation_curve_move=0.46,1.0,0.29,1
animation_curve_tag=0.46,1.0,0.29,1
animation_curve_close=0.08,0.92,0,1
animation_curve_focus=0.46,1.0,0.29,1
animation_curve_opafadeout=0.5,0.5,0.5,0.5
animation_curve_opafadein=0.46,1.0,0.29,1


## Binds
bind=SUPER+ALT,r,reload_config

# Window Management
bind=SUPER,Escape,killclient
bind=SUPER,M,minimized
bind=SUPER+ALT,M,restore_minimized
bind=SUPER,F,togglefullscreen
bind=SUPER+ALT,F,togglemaximizescreen
bind=SUPER,Z,togglefloating
bind=SUPER+CTRL,Z,centerwin
bind=SUPER,O,toggleoverview
bind=SUPER+ALT,O,toggleoverview,1
bind=SUPER,X,toggle_scratchpad

# Applications
bind=SUPER,Q,spawn,foot
bind=SUPER,B,spawn,zen-browser
bind=SUPER+ALT,B,spawn,helium-browser-bin
bind=SUPER,D,spawn,discord
bind=SUPER,S,spawn,steam
bind=SUPER,T,spawn,google-chrome https://tidal.com/feed
bind=SUPER,E,spawn,nautilus /home/rhosm/
bind=SUPER,W,spawn,gnome-text-editor
bind=SUPER,C,spawn,gnome-calculator
bind=SUPER,I,spawn,input-remapper-gtk
bind=SUPER,P,spawn,foot -e btop
bind=SUPER,K,spawn,krita
bind=SUPER,R,spawn,rednotebook
bind=SUPER,F11,spawn,waypaper
bind=SUPER+ALT,V,spawn,foundryvtt
bind=SUPER+ALT,P,spawn,protonvpn-app

# Noctalia shell
bind=SUPER,Menu,spawn,noctalia msg panel-toggle launcher
bind=SUPER+ALT,L,spawn,noctalia msg session lock
bind=SUPER,V,spawn,noctalia msg panel-toggle clipboard
bind=CTRL+ALT,Delete,spawn,noctalia msg panel-toggle session
bind=SUPER+ALT,H,spawn,noctalia msg panel-toggle kenn/keybind-cheatsheet:cheatsheet

# Quick nautilus directories
bind=SUPER+CTRL+ALT,D,spawn,nautilus /home/rhosm/Documents/
bind=SUPER+CTRL+ALT,F,spawn,nautilus /home/rhosm/Downloads/
bind=SUPER+CTRL+ALT,P,spawn,nautilus /home/rhosm/Pictures/
bind=SUPER+CTRL+ALT,V,spawn,nautilus /home/rhosm/Videos/
bind=SUPER+CTRL+ALT,M,spawn,nautilus /home/rhosm/Music/
bind=SUPER+CTRL+ALT,R,spawn,nautilus recent:///
bind=CTRL+ALT,Print,spawn,nautilus /home/rhosm/Pictures/Screenshots

# Move windows
bind=SUPER+SHIFT,left,exchange_client,left
bind=SUPER+SHIFT,right,exchange_client,right
bind=SUPER+SHIFT,up,exchange_client,up
bind=SUPER+SHIFT,down,exchange_client,down

bind=SUPER+SHIFT,insert,tagmon,left
bind=SUPER+SHIFT,delete,tagmon,right

bind=SUPER+SHIFT,1,tag,1
bind=SUPER+SHIFT,2,tag,2
bind=SUPER+SHIFT,3,tag,3
bind=SUPER+SHIFT,4,tag,4
bind=SUPER+SHIFT,5,tag,5
bind=SUPER+SHIFT,6,tag,6
bind=SUPER+SHIFT,7,tag,7
bind=SUPER+SHIFT,8,tag,8
bind=SUPER+SHIFT,9,tag,9
bind=SUPER+SHIFT,0,tag,10

bind=SUPER+SHIFT,Prior,tagtoleft,0
bind=SUPER+SHIFT,Next,tagtoright,0

# Focus navigation
bind=ALT,tab,focusstack,next
bind=SUPER,left,focusdir,left
bind=SUPER,right,focusdir,right
bind=SUPER,up,focusdir,up
bind=SUPER,down,focusdir,down

bind=SUPER,insert,focusmon,left
bind=SUPER,delete,focusmon,right

bind=SUPER,1,view,1
bind=SUPER,2,view,2
bind=SUPER,3,view,3
bind=SUPER,4,view,4
bind=SUPER,5,view,5
bind=SUPER,6,view,6
bind=SUPER,7,view,7
bind=SUPER,8,view,8
bind=SUPER,9,view,9
bind=SUPER,0,view,10

bind=SUPER+ALT,1,toggleview,1
bind=SUPER+ALT,2,toggleview,2
bind=SUPER+ALT,3,toggleview,3
bind=SUPER+ALT,4,toggleview,4
bind=SUPER+ALT,5,toggleview,5
bind=SUPER+ALT,6,toggleview,6
bind=SUPER+ALT,7,toggleview,7
bind=SUPER+ALT,8,toggleview,8
bind=SUPER+ALT,9,toggleview,9
bind=SUPER+ALT,0,toggleview,10

bind=SUPER,Prior,viewtoleft,0
bind=SUPER,Next,viewtoright,0
bind=SUPER,end,viewtoleft_have_client,0
bind=SUPER,home,viewtoright_have_client,0

# Window size
bind=SUPER+CTRL,Prior,setmfact,-0.05
bind=SUPER+CTRL,Next,setmfact,+0.05

scroller_proportion_preset=1.0,0.8,0.5,0.3
bind=SUPER,grave,switch_proportion_preset


# Layouts
circle_layout=dwindle,scroller,tile
bind=SUPER,Space,switch_layout
bind=SUPER,F1,setlayout,tile
bind=SUPER,F2,setlayout,scroller
bind=SUPER,F3,setlayout,dwindle


# Screenshots
bind=SUPER,Print,spawn,sh -c 'grim ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'
bind=SHIFT,Print,spawn,sh -c 'grim -g "$(slurp -b 00000080 -c 00000000)" - | wl-copy'
bind=CTRL,Print,spawn,sh -c 'grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%s).png'

## Window rules
focused_opacity = 0.95
unfocused_opacity = 0.9

# Zen Browser
windowrule=tags:1,appid:zen
windowrule=isfakefullscreen:1,appid:zen
windowrule=monitor:serial:2S6R6HA008726,appid:zen

# Discord
windowrule=tags:1,appid:discord
windowrule=isfakefullscreen:1,appid:discord
windowrule=monitor:serial:GBLMTF073880,appid:discord

# Steam
windowrule=tags:2,appid:steam
windowrule=isfakefullscreen:1,appid:steam
windowrule=monitor:serial:2S6R6HA008726,appid:steam

# Steam Games
windowrule=tags:2,isfullscreen:1,focused_opacity:1.0,unfocused_opacity:1.0,appid:^steam_app_.*

# Krita
windowrule=tags:3,appid:krita
windowrule=monitor:serial:2S6R6HA008726,appid:krita

# Google Chrome
windowrule=tags:2,appid:google-chrome
windowrule=monitor:serial:GBLMTF073880,appid:google-chrome

# --- Floating & Sized Windows ---
# Steam Friends List
windowrule=isfloating:1,width:300,height:800,appid:^steam$,title:^Friends List$

# Quickshell
windowrule=isfloating:1,appid:org.quickshell

# GNOME Calendar (Top-Right position)
windowrule=isfloating:1,offsetx:100,offsety:-100,appid:^org\.gnome\.Calendar$

# Pavucontrol (Top-Left position)
windowrule=isfloating:1,offsetx:-100,offsety:-100,appid:^org\.pulseaudio\.pavucontrol$

# Input Remapper & PolicyKit
windowrule=isfloating:1,appid:^input-remapper-gtk$
windowrule=isfloating:1,appid:^lxqt-policykit-agent$

# Alacritty (Floating terminal with custom size and opacity)
windowrule=isfloating:1,width:1600,height:1000,focused_opacity:0.8,unfocused_opacity:0.8,appid:Alacritty

# Foot (Floating terminal with custom size and opacity)
windowrule=isfloating:1,width:1600,height:1000,focused_opacity:0.8,unfocused_opacity:0.8,appid:foot

# Waypaper
windowrule=isfloating:1,width:1600,height:1000,focused_opacity:1.0,unfocused_opacity:1.0,appid:waypaper

# --- Opacity Exceptions (Full Opacity) ---
windowrule=focused_opacity:1.0,unfocused_opacity:1.0,appid:io.github.celluloid_player.Celluloid
windowrule=focused_opacity:1.0,unfocused_opacity:1.0,appid:foundryvtt
windowrule=focused_opacity:1.0,unfocused_opacity:1.0,appid:org.gnome.Loupe
windowrule=focused_opacity:1.0,unfocused_opacity:1.0,appid:krita

# YouTube / Media match (Zen / Helium)
windowrule=focused_opacity:1.0,unfocused_opacity:1.0,appid:zen,title:.*YouTube.*
windowrule=focused_opacity:1.0,unfocused_opacity:1.0,appid:helium,title:.*YouTube.*

# Krita / Nautilus Sub-windows
windowrule=isfloating:1,appid:^krita$,title:(Docker|Palette|Brush).*
windowrule=isfloating:1,appid:nautilus,title:File Operation Progress
