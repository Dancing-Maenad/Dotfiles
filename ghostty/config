# Ghostty config, converted from kitty.conf
# Save as ~/.config/ghostty/config
# Check it with:  ghostty +validate-config
# Look up action names with:  ghostty +list-actions

# ==========================================
# Fonts
# ==========================================
# Check the exact name with: ghostty +list-fonts
font-family = CaskaydiaCove Nerd Font Mono
font-size = 12
# Ligatures are ON by default (same as kitty's "disable_ligatures never").
# To turn them off:  font-feature = -calt
# kitty's cell_height 105%
adjust-cell-height = 5%

# ==========================================
# Cursor
# ==========================================
cursor-style = bar
# approximate kitty's cursor_beam_thickness 1.5 (pixels, not points)
adjust-cursor-thickness = 2
# No cursor trail option. Ghostty uses custom GLSL shaders for that:
#   custom-shader = /path/to/cursor-trail.glsl

# ==========================================
# Padding, splits, window
# ==========================================
# kitty "window_padding_width 10 14" = 10 vertical, 14 horizontal
window-padding-y = 10
window-padding-x = 14
# Dim unfocused splits (kitty: inactive_text_alpha 0.6)
unfocused-split-opacity = 0.6
# No titlebar, since your compositor draws the borders
window-decoration = false
# New tabs/splits start in the current directory (replaces --cwd=current)
window-inherit-working-directory = true

# ==========================================
# Background
# ==========================================
background-opacity = 0.8
# Blur is compositor-dependent, so set it in Mango instead of here.

# ==========================================
# Tab bar (GTK tab bar: no powerline style or title templates)
# ==========================================
gtk-tabs-location = top
# only show the bar when there is more than one tab
window-show-tab-bar = auto

# ==========================================
# Quality of life
# ==========================================
# NOTE: this is BYTES, not lines (default is about 10 MB)
scrollback-limit = 20000000
copy-on-select = clipboard
mouse-hide-while-typing = true
# Asks before closing only when something is running
confirm-close-surface = true
shell-integration = detect

# Notify when a long command finishes in an unfocused window
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# ==========================================
# Keybindings
# ==========================================
# Splits and tabs (kitty vsplit = side by side = right, hsplit = below = down)
keybind = ctrl+shift+n>w=new_split:right
keybind = ctrl+shift+n>h=new_split:down
keybind = ctrl+shift+n>t=new_tab
keybind = ctrl+shift+s>c=reset
keybind = ctrl+shift+bracket_left=previous_tab
keybind = ctrl+shift+bracket_right=next_tab
keybind = ctrl+shift+1=goto_tab:1
keybind = ctrl+shift+2=goto_tab:2
keybind = ctrl+shift+3=goto_tab:3
keybind = ctrl+shift+4=goto_tab:4
keybind = ctrl+shift+5=goto_tab:5

# Move between splits, and zoom one
keybind = ctrl+shift+s>left=goto_split:left
keybind = ctrl+shift+s>down=goto_split:down
keybind = ctrl+shift+s>up=goto_split:up
keybind = ctrl+shift+s>right=goto_split:right
keybind = ctrl+shift+s>z=toggle_split_zoom

# Resize splits (Ghostty counts PIXELS, kitty counted cells; adjust to taste)
keybind = ctrl+shift+s>alt+left=resize_split:left,30
keybind = ctrl+shift+s>alt+right=resize_split:right,30
keybind = ctrl+shift+s>alt+up=resize_split:up,30
keybind = ctrl+shift+s>alt+down=resize_split:down,30
# Font size
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1

# Opacity: Ghostty can only toggle transparent/opaque, not step by 0.1
# keybind = ctrl+alt+period=toggle_background_opacity

# Closing (ctrl+shift+w is already the default for close_surface)
keybind = ctrl+alt+w=close_tab
keybind = ctrl+alt+shift+w=close_surface

# Search (free key now that the hints kittens are gone)
keybind = ctrl+shift+f=start_search

# Unbinds
keybind = super+ctrl+shift+j=unbind
keybind = super+ctrl+bracket_left=unbind
keybind = super+ctrl+bracket_right=unbind
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+j=unbind
keybind = ctrl+alt+shift+j=unbind

# ==========================================
# Colours
# ==========================================
theme = noctalia
